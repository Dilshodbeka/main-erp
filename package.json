{
  "name": "aliya-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "build:bot": "node scripts/build-bot.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "deploy": "npm run build && node -e \"require('node:fs').rmSync('dist/_redirects',{force:true})\" && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.81.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "happy-dom": "^21.0.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.156.0"
  }
}
